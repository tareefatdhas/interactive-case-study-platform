rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    
    function isTeacher() {
      return isAuthenticated() && !isAnonymous() &&
        get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isTeacherOfResource(teacherId) {
      return isAuthenticated() && request.auth.uid == teacherId;
    }
    
    // Teachers collection - only teachers can read/write their own data
    match /teachers/{teacherId} {
      allow read: if isOwner(teacherId);
      allow create: if isAuthenticated()
        && request.auth.uid == teacherId
        && request.resource.data.billing.plan == 'pilot'
        && request.resource.data.billing.status == 'pilot'
        && request.resource.data.billing.pilotSessionsUsed == 0;
      // Billing fields are written only by trusted Cloud Functions after Stripe
      // or server-side entitlement checks. Instructor devices may not change them.
      allow update: if isOwner(teacherId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['billing']);
      allow delete: if isOwner(teacherId);
    }
    
    // Case studies - teachers can manage, students (anonymous) can read
    match /casestudies/{caseStudyId} {
      allow read: if isAuthenticated(); // Both teachers and anonymous students can read
      allow write: if isTeacher() && 
        isTeacherOfResource(resource.data.teacherId);
      allow create: if isTeacher() && 
        isTeacherOfResource(request.resource.data.teacherId);
    }
    
    // Sessions - teachers can manage, students (anonymous) can read and join
    match /sessions/{sessionId} {
      // Standalone lesson plans can contain hidden quiz answers. Live students use
      // the sanitized Realtime Database join record instead of this document.
      allow read: if isAuthenticated() && (!isAnonymous() || resource.data.sessionType != 'standalone');
      allow update, delete: if isTeacher()
        && isTeacherOfResource(resource.data.teacherId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['startedAt', 'billingSessionClaimedAt'])
        && (resource.data.active == true || request.resource.data.active != true || request.resource.data.keys().hasAny(['billingSessionClaimedAt']));
      allow create: if isTeacher() && 
        isTeacherOfResource(request.resource.data.teacherId)
        && request.resource.data.active == false;
      
      // Legacy case-study students may only append one joined student ID and
      // refresh the activity timestamp. They cannot change lesson content,
      // ownership, lifecycle, or hidden quiz data.
      allow update: if isAuthenticated() && isAnonymous()
        && resource.data.sessionType != 'standalone'
        && resource.data.active == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentsJoined', 'lastActivityAt'])
        && request.resource.data.studentsJoined is list
        && (
          (!resource.data.keys().hasAny(['studentsJoined']) && request.resource.data.studentsJoined.size() <= 1)
          || (
            resource.data.keys().hasAny(['studentsJoined'])
            && request.resource.data.studentsJoined.size() >= resource.data.studentsJoined.size()
            && request.resource.data.studentsJoined.size() <= resource.data.studentsJoined.size() + 1
            && request.resource.data.studentsJoined.hasAll(resource.data.studentsJoined)
          )
        )
        && request.resource.data.lastActivityAt is timestamp;
    }

    // Student identity records are private to their device identity and teachers.
    match /students/{studentId} {
      allow read: if isTeacher() || (isAuthenticated() && resource.data.authorUid == request.auth.uid);
      allow create: if isAnonymous() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isTeacher() || (isAuthenticated() && resource.data.authorUid == request.auth.uid && request.resource.data.authorUid == request.auth.uid);
    }
    
    // Responses are private to the submitting device identity and teachers.
    match /responses/{responseId} {
      allow read: if isTeacher() || (isAuthenticated() && resource.data.authorUid == request.auth.uid);
      allow create: if isAnonymous() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isTeacher() || (isAuthenticated() && resource.data.authorUid == request.auth.uid && request.resource.data.authorUid == request.auth.uid);
    }
    
    // Student grades - teachers can read/write, students can read their own
    match /studentGrades/{gradeId} {
      allow read, write: if isTeacher();
      allow read: if isAuthenticated() && 
        resource.data.studentId == request.auth.uid;
    }
    
    // Courses - teachers can manage their courses
    match /courses/{courseId} {
      allow read, update, delete: if isTeacher() &&
        isTeacherOfResource(resource.data.teacherId);
      // New classes go through createInstructorCourse so the current plan is
      // checked atomically before the document is created.
      allow create: if false;
    }

    // Payment records are server-only. The instructor receives a sanitized
    // billing summary through an authenticated callable function.
    match /stripeWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    // A course-level team module can be shared outside a live session. Team
    // names are reserved in a separate claim document so duplicates cannot be
    // created by two phones at the same time.
    match /teamModules/{courseId} {
      allow get: if isAuthenticated();
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid && request.resource.data.courseId == courseId;
      allow update, delete: if isTeacher() && resource.data.teacherId == request.auth.uid && request.resource.data.teacherId == request.auth.uid;

      match /nameClaims/{claimId} {
        allow get: if isAuthenticated();
        allow list: if isTeacher() && get(/databases/$(database)/documents/teamModules/$(courseId)).data.teacherId == request.auth.uid;
        allow create: if isAuthenticated()
          && (request.resource.data.creatorUid == request.auth.uid || request.resource.data.teacherId == request.auth.uid)
          && request.resource.data.courseId == courseId
          && claimId == request.resource.data.normalizedName
          && getAfter(/databases/$(database)/documents/teamModules/$(courseId)/teams/$(request.resource.data.teamId)).data.normalizedName == request.resource.data.normalizedName;
        allow delete: if isAuthenticated() && (resource.data.creatorUid == request.auth.uid || resource.data.teacherId == request.auth.uid);
        allow update: if false;
      }

      match /teams/{teamId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && (request.resource.data.creatorUid == request.auth.uid || request.resource.data.teacherId == request.auth.uid)
          && request.resource.data.courseId == courseId
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 48
          && request.resource.data.normalizedName is string
          && request.resource.data.color in ['violet', 'blue', 'teal', 'green', 'gold', 'coral', 'pink', 'navy']
          && get(/databases/$(database)/documents/teamModules/$(courseId)).data.enabled == true
          && get(/databases/$(database)/documents/teamModules/$(courseId)).data.teacherId == request.resource.data.teacherId
          && getAfter(/databases/$(database)/documents/teamModules/$(courseId)/nameClaims/$(request.resource.data.normalizedName)).data.teamId == teamId;
        allow update: if isAuthenticated()
          && (resource.data.creatorUid == request.auth.uid || resource.data.teacherId == request.auth.uid)
          && request.resource.data.courseId == courseId
          && request.resource.data.teacherId == resource.data.teacherId
          && request.resource.data.creatorUid == resource.data.creatorUid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 48
          && request.resource.data.color in ['violet', 'blue', 'teal', 'green', 'gold', 'coral', 'pink', 'navy']
          && getAfter(/databases/$(database)/documents/teamModules/$(courseId)/nameClaims/$(request.resource.data.normalizedName)).data.teamId == teamId;
        allow delete: if isAuthenticated() && (resource.data.creatorUid == request.auth.uid || resource.data.teacherId == request.auth.uid);
      }

      match /memberships/{studentUid} {
        allow get: if isAuthenticated() && (studentUid == request.auth.uid || resource.data.teacherId == request.auth.uid);
        allow list: if isTeacher() && get(/databases/$(database)/documents/teamModules/$(courseId)).data.teacherId == request.auth.uid;
        allow create: if isAuthenticated()
          && (studentUid == request.auth.uid || request.resource.data.teacherId == request.auth.uid)
          && request.resource.data.studentUid == studentUid
          && request.resource.data.courseId == courseId
          && request.resource.data.studentNumber is string
          && request.resource.data.studentNumber.size() >= 3
          && request.resource.data.studentNumber.size() <= 32
          && get(/databases/$(database)/documents/teamModules/$(courseId)).data.enabled == true
          && getAfter(/databases/$(database)/documents/teamModules/$(courseId)/teams/$(request.resource.data.teamId)).data.courseId == courseId;
        allow update: if isAuthenticated()
          && (studentUid == request.auth.uid || resource.data.teacherId == request.auth.uid)
          && request.resource.data.studentUid == studentUid
          && request.resource.data.courseId == courseId
          && request.resource.data.teacherId == resource.data.teacherId
          && get(/databases/$(database)/documents/teamModules/$(courseId)/teams/$(request.resource.data.teamId)).data.courseId == courseId;
        allow delete: if isAuthenticated() && (studentUid == request.auth.uid || resource.data.teacherId == request.auth.uid);
      }
    }
    
    // Highlights - students can manage their own highlights, teachers can read all
    match /highlights/{highlightId} {
      allow read: if isTeacher() || (request.auth != null && resource.data.authorUid == request.auth.uid) || resource.data.shared == true;
      
      allow create: if request.auth != null &&
                       request.resource.data.authorUid == request.auth.uid;
                       
      allow update: if request.auth != null && 
                       resource.data.authorUid == request.auth.uid &&
                       request.resource.data.authorUid == request.auth.uid;
                       
      allow delete: if request.auth != null && 
                       resource.data.authorUid == request.auth.uid;
    }
    
    // Student Progress - students can manage their own progress, teachers can read all
    match /studentProgress/{progressId} {
      allow read: if isTeacher() || (isAuthenticated() && resource.data.authorUid == request.auth.uid);
      allow create: if isAnonymous() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        isTeacher() || // Teachers can update any progress
        (isAnonymous() && resource.data.authorUid == request.auth.uid && request.resource.data.authorUid == request.auth.uid)
      );
    }
    
    // Student Overall Progress - students can manage their own overall progress, teachers can read all
    match /studentOverallProgress/{studentId} {
      allow read: if isTeacher() || (isAuthenticated() && resource.data.authorUid == request.auth.uid);
      allow create: if isAnonymous() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        isTeacher() || // Teachers can update any overall progress
        (isAnonymous() && resource.data.authorUid == request.auth.uid && request.resource.data.authorUid == request.auth.uid)
      );
    }
    
    // Achievements - teachers can manage their own achievements, students can read enabled ones
    match /achievements/{achievementId} {
      allow read: if isAuthenticated(); // All authenticated users can read achievements
      allow create: if isTeacher() && 
        isTeacherOfResource(request.resource.data.teacherId); // Teachers can create their own achievements
      allow update: if isTeacher() && 
        isTeacherOfResource(resource.data.teacherId); // Teachers can update their own achievements
      allow delete: if isTeacher() && 
        isTeacherOfResource(resource.data.teacherId); // Teachers can delete their own achievements
    }
    
    // Student Achievements - students can read their own, achievements are created by system
    match /studentAchievements/{studentAchievementId} {
      allow read: if isTeacher() || (isAuthenticated() && resource.data.authorUid == request.auth.uid);
      allow create: if isAnonymous() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isTeacher() || (isAuthenticated() && resource.data.authorUid == request.auth.uid && request.resource.data.authorUid == request.auth.uid);
    }

    // Reward definitions are public to signed-in classroom participants, but only
    // the owning instructor can create or change them.
    match /rewardDefinitions/{rewardId} {
      allow read: if isAuthenticated();
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // Students may request a reward for their own anonymous device identity.
    // Instructors remain the final approval gate and can review only their queue.
    match /rewardRequests/{requestId} {
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.authorUid == request.auth.uid;
      allow create: if isAnonymous()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.pointsAtRequest is number
        && request.resource.data.pointsRequired is number
        && (!request.resource.data.keys().hasAny(['studentDisplayName']) || (request.resource.data.studentDisplayName is string && request.resource.data.studentDisplayName.size() <= 60))
        && exists(/databases/$(database)/documents/rewardDefinitions/$(request.resource.data.rewardId))
        && get(/databases/$(database)/documents/rewardDefinitions/$(request.resource.data.rewardId)).data.enabled == true
        && request.resource.data.teacherId == get(/databases/$(database)/documents/rewardDefinitions/$(request.resource.data.rewardId)).data.teacherId
        && request.resource.data.courseId == get(/databases/$(database)/documents/rewardDefinitions/$(request.resource.data.rewardId)).data.courseId
        && request.resource.data.courseCode == get(/databases/$(database)/documents/rewardDefinitions/$(request.resource.data.rewardId)).data.courseCode
        && request.resource.data.rewardName == get(/databases/$(database)/documents/rewardDefinitions/$(request.resource.data.rewardId)).data.name
        && request.resource.data.pointsRequired == get(/databases/$(database)/documents/rewardDefinitions/$(request.resource.data.rewardId)).data.pointsRequired;
      allow update: if isTeacher()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'instructorNote'])
        && (request.resource.data.status == 'approved' || request.resource.data.status == 'declined' || request.resource.data.status == 'used');
      allow delete: if false;
    }
  }
}
